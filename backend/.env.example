# Copy this file to `.env` and fill in your real values. Never commit the real .env file.

# ---- PostgreSQL ----
DATABASE_URL=postgresql://boutique_user:boutique_pass@localhost:5432/blessings

# ---- CORS: comma-separated list of frontend URLs allowed to call this API ----
FRONTEND_ORIGINS=http://localhost:5173

# ---- Admin-only API key ----
# Use a long random secret in production. Required for POST /api/products/ and GET /api/checkout/orders/{id}.
ADMIN_API_KEY=replace-with-a-long-random-secret

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youraddress@gmail.com
SMTP_PASSWORD=your16charapppassword
SMTP_FROM_EMAIL=youraddress@gmail.com
SHOP_OWNER_EMAIL=owner@maisonelan.com

# ---- WhatsApp: click-to-chat link ----
SHOP_WHATSAPP_NUMBER=919876543210

# ---- WhatsApp: optional automatic sending via Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID=
